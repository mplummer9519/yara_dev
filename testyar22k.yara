    meta:
        tc_detection_type = "Ransomware" // Has to be a valid RL malware type
        tc_detection_name = "Oof" // Can be an arbitrary malware family name
        tc_detection_factor = 5 // 0-5, where 5 is most dangerous
    strings:
        $1 = "example"
        $2 = { DE AD BE EF }
    condition:
        $1 or $2
}

